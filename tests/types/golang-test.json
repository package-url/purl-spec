      "expected_output": {
        "type": "golang",
        "namespace": "google.golang.org",
        "name": "genproto",
        "version": null,
        "qualifiers": null,
        "subpath": "googleapis/api/annotations"
      },
      "expected_failure": false,
      "expected_message": null
    },
