{
  "$schema": "https://packageurl.org/schemas/purl-test.schema-0.1.json",
  "tests": [
    {
      "description": "Test with all schema elements",
      "test_group": "required",
      "test_type": "parse",
      "input": "pkg:spack/builtin/zlib@1.3.2?sha=u463uoum2lujbc2ug4fpbersp4jev2yl",
      "expected_output": {
        "type": "spack",
        "namespace": "builtin",
        "name": "zlib",
        "version": "1.3.2",
        "qualifiers": {
          "sha": "u463uoum2lujbc2ug4fpbersp4jev2yl"
        },
        "subpath": null
      },
      "expected_failure": false
    },
    {
      "description": "Test with no hash",
      "test_group": "required",
      "test_type": "parse",
      "input": "pkg:spack/builtin/zlib@1.3.2",
      "expected_output": {
        "type": "spack",
        "namespace": "builtin",
        "name": "zlib",
        "version": "1.3.2",
        "qualifiers": {
          "sha": null
        },
        "subpath": null
      },
      "expected_failure": false
    },
    {
      "description": "Test with no hash or version",
      "test_group": "required",
      "test_type": "parse",
      "input": "pkg:spack/builtin/zlib",
      "expected_output": {
        "type": "spack",
        "namespace": "builtin",
        "name": "zlib",
        "version": null,
        "qualifiers": {
          "sha": null
        },
        "subpath": null
      },
      "expected_failure": false
    },
    {
      "description": "Test with no namespace",
      "test_group": "required",
      "test_type": "parse",
      "input": "pkg:spack/zlib@1.3.2",
      "expected_output": {
        "type": "spack",
        "namespace": "builtin",
        "name": "zlib",
        "version": "1.3.2",
        "qualifiers": {
          "sha": null
        },
        "subpath": null
      },
      "expected_failure": true,
      "expected_failure_reason": "",
      "expected_message": "Should fail to parse PURL that has no namespace"
    }
  ]
}
